local indicatorEnabled = false
local ballSizeMultiplier = 6
local activeConnections = {}
local spawnedBalls = {}

local workspace = game:GetService("Workspace")

local function setupBallIndicator(subChild)
    if not indicatorEnabled then return end
    
    if subChild.Name:find("Cube") and subChild:IsA("BasePart") then
        local clientBall = subChild.Parent
        if clientBall and not clientBall:FindFirstChild("Ball.001") then
            local ballPart = Instance.new("Part")
            ballPart.Name = "Ball.001"
            ballPart.Shape = Enum.PartType.Ball
            
            local finalSize = ballSizeMultiplier * 2 -- แก้ไขการคำนวณให้ถูกต้อง
            ballPart.Size = Vector3.new(finalSize, finalSize, finalSize)
            
            ballPart.CFrame = subChild.CFrame
            ballPart.Transparency = 0.7
            ballPart.Color = Color3.fromRGB(0, 255, 0)
            ballPart.Material = Enum.Material.ForceField
            ballPart.CanCollide = false
            ballPart.Anchored = false
            ballPart.Parent = clientBall

            local weld = Instance.new("WeldConstraint")
            weld.Part0 = subChild
            weld.Part1 = ballPart
            weld.Parent = ballPart
            
            table.insert(spawnedBalls, ballPart)
        end
    end
end

local function removeAllIndicators()
    for _, ball in ipairs(spawnedBalls) do
        if ball and ball.Parent then
            ball:Destroy()
        end
    end
    spawnedBalls = {}
end

local function processClientBall(clientBall)
    for _, subChild in ipairs(clientBall:GetChildren()) do
        setupBallIndicator(subChild)
    end

    local conn = clientBall.ChildAdded:Connect(function(subChild)
        task.defer(function()
            setupBallIndicator(subChild)
        end)
    end)
    table.insert(activeConnections, conn)
end

local function startIndicatorSystem()
    for _, child in ipairs(workspace:GetChildren()) do
        if child.Name:find("CLIENT_BALL") then
            processClientBall(child)
        end
    end

    local conn = workspace.ChildAdded:Connect(function(child)
        if child.Name:find("CLIENT_BALL") then
            task.defer(function()
                processClientBall(child)
            end)
        end
    end)
    table.insert(activeConnections, conn)
end

local function stopIndicatorSystem()
    indicatorEnabled = false
    for _, conn in ipairs(activeConnections) do
        if conn then
            conn:Disconnect()
        end
    end
    activeConnections = {}
    removeAllIndicators()
end

local Toggle = Tabs.Main:AddToggle("IndicatorToggle", { Title = "Enable Ball Size", Default = false })

Toggle:OnChanged(function()
    indicatorEnabled = Toggle.Value
    if indicatorEnabled then
        startIndicatorSystem()
    else
        stopIndicatorSystem()
    end
end)

